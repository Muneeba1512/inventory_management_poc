<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Create Product Wizard Form -->
    <!-- ========================================================= -->

    <record id="view_inventory_product_create_wizard_form" model="ir.ui.view">
        <field name="name">inventory.product.create.wizard.form</field>
        <field name="model">inventory.product.create.wizard</field>
        <field name="arch" type="xml">

            <form string="Create Product">

                <group>

                    <field name="barcode" readonly="1"/>

                    <field name="name" placeholder="Product name"/>

                    <field name="receipt_id" invisible="1"/>

                    <field name="line_id" invisible="1"/>

                </group>

                <footer>

                    <button
                        name="action_create_and_add"
                        string="Create &amp; Add"
                        type="object"
                        class="oe_highlight"/>

                    <button string="Cancel" special="cancel"/>

                </footer>

            </form>

        </field>
    </record>

</odoo>
