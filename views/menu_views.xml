<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Root Application -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_inventory_management_root"
        name="Inventory Management"
        web_icon="inventory_management_poc,static/description/icon.png"
        sequence="10"/>

    <!-- ========================================================= -->
    <!-- 1. Dashboard (all roles) — KPI cards + activity panels      -->
    <!-- (FDD §5.4), scoped per role via the same record rules the   -->
    <!-- underlying models already use. -->
    <!-- ========================================================= -->

    <record id="action_inventory_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">inventory_management_poc.dashboard</field>
    </record>

    <menuitem
        id="menu_inventory_dashboard"
        name="Dashboard"
        parent="menu_inventory_management_root"
        action="action_inventory_dashboard"
        sequence="1"/>

    <!-- ========================================================= -->
    <!-- 2. Warehouse (Warehouse Staff, Admin) — single leaf menu.  -->
    <!-- Opens Receipts; Stock by Location is reached via the      -->
    <!-- custom tab strip (no dropdown — see static/src/js).       -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_inventory_warehouse"
        name="Warehouse"
        parent="menu_inventory_management_root"
        action="action_inventory_receipt"
        groups="inventory_management_poc.group_inventory_warehouse,inventory_management_poc.group_inventory_admin"
        sequence="2"/>

    <!-- ========================================================= -->
    <!-- 3. Requests (all roles) — single leaf menu, opens          -->
    <!-- "To Approve"; To Fulfill / My Requests via the tab strip.  -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_inventory_requests"
        name="Requests"
        parent="menu_inventory_management_root"
        action="action_inventory_store_request_to_approve"
        sequence="3"/>

    <!-- ========================================================= -->
    <!-- 4. Stores (Store Manager — own store, Admin) — single      -->
    <!-- leaf menu, opens Manage Stores; Record Consumption / My    -->
    <!-- Store Stock via the tab strip. -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_inventory_store"
        name="Stores"
        parent="menu_inventory_management_root"
        action="action_inventory_store"
        groups="inventory_management_poc.group_inventory_store,inventory_management_poc.group_inventory_admin"
        sequence="4"/>

    <!-- ========================================================= -->
    <!-- 5. Low Stock Alerts (all roles) — opens Warehouse Alerts;   -->
    <!-- Store Alerts reached via the tab strip. Warehouse/Store     -->
    <!-- Staff see everything; Store Manager is scoped to their own  -->
    <!-- store by the record rule on inventory.low.stock.alert.     -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_inventory_alerts"
        name="Low Stock Alerts"
        parent="menu_inventory_management_root"
        action="action_inventory_low_stock_alert_warehouse"
        sequence="5"/>

    <!-- ========================================================= -->
    <!-- 6. Configuration (Admin only) — now two sub-items          -->
    <!-- (Products, Settings), per FDD §5.2/§5.14 — a real Odoo      -->
    <!-- dropdown submenu, not the custom tab strip used elsewhere. -->
    <!-- Wraps the native product action in our own record so we    -->
    <!-- can set a breadcrumb-friendly name without renaming shared -->
    <!-- native data.                                                -->
    <!-- ========================================================= -->

    <record id="action_inventory_configuration_products" model="ir.actions.act_window">

        <field name="name">Configuration / Products</field>

        <field name="res_model">product.template</field>

        <field name="view_mode">list,form,kanban</field>

        <field name="context">{'search_default_goods': 1, 'default_is_storable': True}</field>

        <field name="help" type="html">         <p class="o_view_nocontent_smiling_face">
                No product found. Let's create one!
            </p>

            <p>
                Track your stock quantities by creating storable products.
            </p>

        </field>

    </record>

    <menuitem
        id="menu_inventory_administration"
        name="Configuration"
        parent="menu_inventory_management_root"
        groups="inventory_management_poc.group_inventory_admin"
        sequence="6"/>

    <menuitem
        id="menu_inventory_administration_products"
        name="Products"
        parent="menu_inventory_administration"
        action="action_inventory_configuration_products"
        sequence="1"/>

    <menuitem
        id="menu_inventory_administration_settings"
        name="Settings"
        parent="menu_inventory_administration"
        action="action_inventory_res_config_settings"
        sequence="2"/>

</odoo>