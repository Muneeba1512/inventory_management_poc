<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Root Application -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_inventory_management_root"
        name="Inventory Management"
        web_icon="inventory_management_poc,static/description/icon.png"
        sequence="10"/>

    <!-- ========================================================= -->
    <!-- 1. Dashboard (all roles) — placeholder client action so    -->
    <!-- the menu actually shows in the nav (an actionless,         -->
    <!-- childless menu is invisible per Odoo's own visibility      -->
    <!-- rules, not just empty). Real content ships in a later      -->
    <!-- sprint. -->
    <!-- ========================================================= -->

    <record id="action_inventory_dashboard_placeholder" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">inventory_management_poc.coming_soon</field>
        <field name="params" eval="{'title': 'Dashboard', 'message': 'KPI cards (on-hand value, open requests, alerts) and activity panels are planned for a future sprint.'}"/>
    </record>

    <menuitem
        id="menu_inventory_dashboard"
        name="Dashboard"
        parent="menu_inventory_management_root"
        action="action_inventory_dashboard_placeholder"
        sequence="1"/>

    <!-- ========================================================= -->
    <!-- 2. Warehouse (Warehouse Staff, Admin) — single leaf menu.  -->
    <!-- Opens Receipts; Stock by Location is reached via the      -->
    <!-- custom tab strip (no dropdown — see static/src/js).       -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_inventory_warehouse"
        name="Warehouse"
        parent="menu_inventory_management_root"
        action="action_inventory_receipt"
        groups="inventory_management_poc.group_inventory_warehouse,inventory_management_poc.group_inventory_admin"
        sequence="2"/>

    <!-- ========================================================= -->
    <!-- 3. Requests (all roles) — single leaf menu, opens          -->
    <!-- "To Approve"; To Fulfill / My Requests via the tab strip.  -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_inventory_requests"
        name="Requests"
        parent="menu_inventory_management_root"
        action="action_inventory_store_request_to_approve"
        sequence="3"/>

    <!-- ========================================================= -->
    <!-- 4. Stores (Store Manager — own store, Admin) — single      -->
    <!-- leaf menu, opens Manage Stores; Record Consumption / My    -->
    <!-- Store Stock via the tab strip. -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_inventory_store"
        name="Stores"
        parent="menu_inventory_management_root"
        action="action_inventory_store"
        groups="inventory_management_poc.group_inventory_store,inventory_management_poc.group_inventory_admin"
        sequence="4"/>

    <!-- ========================================================= -->
    <!-- 5. Low Stock Alerts (all roles) — same placeholder         -->
    <!-- pattern as Dashboard; the 7-day/10-day alert engine ships  -->
    <!-- in Sprint 3. -->
    <!-- ========================================================= -->

    <record id="action_inventory_alerts_placeholder" model="ir.actions.client">
        <field name="name">Low Stock Alerts</field>
        <field name="tag">inventory_management_poc.coming_soon</field>
        <field name="params" eval="{'title': 'Low Stock Alerts', 'message': 'Warehouse and store alerts, computed from the 7-day consumption window and 10-day cover threshold, are planned for a future sprint.'}"/>
    </record>

    <menuitem
        id="menu_inventory_alerts"
        name="Low Stock Alerts"
        parent="menu_inventory_management_root"
        action="action_inventory_alerts_placeholder"
        sequence="5"/>

    <!-- ========================================================= -->
    <!-- 6. Configuration (Admin only) — single leaf menu, opens    -->
    <!-- Products directly (no dropdown). Wraps the native product  -->
    <!-- action in our own record so we can set a breadcrumb-       -->
    <!-- friendly name without renaming shared native data.        -->
    <!-- ========================================================= -->

    <record id="action_inventory_configuration_products" model="ir.actions.act_window">

        <field name="name">Configuration / Products</field>

        <field name="res_model">product.template</field>

        <field name="view_mode">list,form,kanban</field>

        <field name="context">{'search_default_goods': 1, 'default_is_storable': True}</field>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                No product found. Let's create one!
            </p>

            <p>
                Track your stock quantities by creating storable products.
            </p>

        </field>

    </record>

    <menuitem
        id="menu_inventory_administration"
        name="Configuration"
        parent="menu_inventory_management_root"
        action="action_inventory_configuration_products"
        groups="inventory_management_poc.group_inventory_admin"
        sequence="6"/>

</odoo>