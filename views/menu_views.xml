<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Root Application -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_inventory_management_root"
        name="Inventory Management"
        web_icon="inventory_management_poc,static/description/icon.png"
        sequence="10"/>

    <!-- ========================================================= -->
    <!-- 1. Dashboard -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_inventory_dashboard"
        name="Dashboard"
        parent="menu_inventory_management_root"
        sequence="1"/>

    <!-- ========================================================= -->
    <!-- 2. Warehouse (Warehouse Staff, Admin) -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_inventory_warehouse"
        name="Warehouse"
        parent="menu_inventory_management_root"
        groups="inventory_management_poc.group_inventory_warehouse,inventory_management_poc.group_inventory_admin"
        sequence="2"/>

    <menuitem
        id="menu_inventory_receipt"
        name="Receipts"
        parent="menu_inventory_warehouse"
        action="action_inventory_receipt"
        groups="inventory_management_poc.group_inventory_warehouse,inventory_management_poc.group_inventory_admin"
        sequence="1"/>

    <menuitem
        id="menu_inventory_stock_by_location"
        name="Stock by Location"
        parent="menu_inventory_warehouse"
        action="action_inventory_stock_by_location"
        groups="inventory_management_poc.group_inventory_warehouse,inventory_management_poc.group_inventory_admin"
        sequence="2"/>

    <!-- ========================================================= -->
    <!-- 3. Requests (all roles — single list, tabs are saved       -->
    <!-- filters: To Approve / To Fulfill / My Requests)            -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_inventory_requests"
        name="Requests"
        parent="menu_inventory_management_root"
        action="action_inventory_store_request"
        sequence="3"/>

    <!-- ========================================================= -->
    <!-- 4. Stores (Store Manager — own store, Admin) -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_inventory_store"
        name="Stores"
        parent="menu_inventory_management_root"
        groups="inventory_management_poc.group_inventory_store,inventory_management_poc.group_inventory_admin"
        sequence="4"/>

    <menuitem
        id="menu_inventory_store_manage"
        name="Manage Stores"
        parent="menu_inventory_store"
        action="action_inventory_store"
        groups="inventory_management_poc.group_inventory_store,inventory_management_poc.group_inventory_admin"
        sequence="1"/>

    <menuitem
        id="menu_inventory_store_consumption"
        name="Record Consumption"
        parent="menu_inventory_store"
        action="action_inventory_store_consumption"
        groups="inventory_management_poc.group_inventory_store,inventory_management_poc.group_inventory_admin"
        sequence="2"/>

    <menuitem
        id="menu_inventory_store_my_stock"
        name="My Store Stock"
        parent="menu_inventory_store"
        action="action_inventory_stock_by_location"
        groups="inventory_management_poc.group_inventory_store,inventory_management_poc.group_inventory_admin"
        sequence="3"/>

    <!-- ========================================================= -->
    <!-- 5. Low Stock Alerts (all roles — content ships in a later  -->
    <!-- sprint; menu placeholder kept at the spec'd position)      -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_inventory_alerts"
        name="Low Stock Alerts"
        parent="menu_inventory_management_root"
        sequence="5"/>

    <!-- ========================================================= -->
    <!-- 6. Configuration (Admin only) -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_inventory_administration"
        name="Configuration"
        parent="menu_inventory_management_root"
        groups="inventory_management_poc.group_inventory_admin"
        sequence="6"/>

    <menuitem
        id="menu_inventory_configuration_products"
        name="Products"
        parent="menu_inventory_administration"
        action="stock.product_template_action_product"
        groups="inventory_management_poc.group_inventory_admin"
        sequence="1"/>

</odoo>
