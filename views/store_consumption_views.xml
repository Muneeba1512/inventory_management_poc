<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Store Consumption Tree View -->
    <!-- ========================================================= -->

    <record id="view_inventory_store_consumption_tree" model="ir.ui.view">
        <field name="name">inventory.store.consumption.tree</field>
        <field name="model">inventory.store.consumption</field>
        <field name="arch" type="xml">

            <!-- Fixed native widths (~20/25/20/10/12.5/12.5% of an 800px
                 baseline). All six columns are left-aligned, including
                 Quantity (numeric) and Status (badge) — both deliberate
                 exceptions to Odoo's own defaults for those types; see
                 list_views.scss for the two small overrides that make
                 that possible, scoped specifically to this list. -->
            <list string="Store Consumption">

                <field name="name" width="160px"/>

                <field name="product_summary" string="Product" width="200px"/>

                <field name="store_id" width="160px"/>

                <field name="total_quantity" string="Quantity" width="80px"/>

                <field name="date" width="100px"/>

                <field
                    name="state"
                    widget="badge"
                    width="100px"
                    decoration-muted="state == 'draft'"
                    decoration-success="state == 'done'"/>

            </list>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Store Consumption Form View -->
    <!-- ========================================================= -->

    <record id="view_inventory_store_consumption_form" model="ir.ui.view">
        <field name="name">inventory.store.consumption.form</field>
        <field name="model">inventory.store.consumption</field>
        <field name="arch" type="xml">

            <form string="Store Consumption">

                <header>

                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'draft'"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>

                </header>

                <sheet>

                    <div class="alert alert-info" role="alert">
                        Recording consumption lowers store stock and builds the
                        7-day average used for store-level low-stock alerts.
                    </div>

                    <group>

                        <group>

                            <field name="name" readonly="1"/>

                            <field name="store_id" readonly="state != 'draft'"/>

                        </group>

                        <group>

                            <field name="date" readonly="state != 'draft'"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Lines">

                            <field name="line_ids" readonly="state != 'draft'">

                                <!-- Column-width standard: Medium=140px,
                                     Small=90px. Product deliberately has
                                     NO fixed width so it absorbs leftover
                                     space (native Odoo pattern). -->
                                <list editable="bottom">

                                    <field name="product_id"/>

                                    <field name="quantity" width="90px" sum="Total Quantity"/>

                                    <field name="uom_id" width="140px"/>

                                    <field name="currency_id" column_invisible="1"/>

                                    <field name="unit_cost" widget="monetary" width="140px" readonly="1"/>

                                    <field name="consumed_value" widget="monetary" width="140px" sum="Total" readonly="1"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Store Consumption Search View -->
    <!-- ========================================================= -->

    <record id="view_inventory_store_consumption_search" model="ir.ui.view">
        <field name="name">inventory.store.consumption.search</field>
        <field name="model">inventory.store.consumption</field>
        <field name="arch" type="xml">

            <search>

                <field name="name"/>

                <field name="store_id"/>

                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>

                <filter name="done" string="Done" domain="[('state','=','done')]"/>

                <group>

                    <filter
                        name="group_by_store"
                        string="Store"
                        context="{'group_by':'store_id'}"/>

                    <filter
                        name="group_by_date"
                        string="Date"
                        context="{'group_by':'date'}"/>

                </group>

            </search>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Store Consumption Action -->
    <!-- ========================================================= -->

    <record id="action_inventory_store_consumption" model="ir.actions.act_window">

        <field name="name">Stores / Record Consumption</field>

        <field name="res_model">inventory.store.consumption</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id" ref="view_inventory_store_consumption_search"/>

        <field name="context">{'inventory_tab_group': 'stores', 'inventory_tab_key': 'record_consumption'}</field>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Record your first consumption entry.
            </p>

            <p>
                Store Managers log products used or sold here. This lowers store
                stock and feeds the 7-day low-stock average.
            </p>

        </field>

    </record>

</odoo>
