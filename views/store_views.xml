<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Store Tree View -->
    <!-- ========================================================= -->

    <record id="view_inventory_store_tree" model="ir.ui.view">
        <field name="name">inventory.store.tree</field>
        <field name="model">inventory.store</field>
        <field name="arch" type="xml">

            <list string="Stores">

                <field name="name"/>

                <field name="store_code"/>

                <field name="store_manager_id"/>

                <field name="stock_location_id"/>

                <field name="active"/>

            </list>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Store Form View -->
    <!-- ========================================================= -->

    <record id="view_inventory_store_form" model="ir.ui.view">
        <field name="name">inventory.store.form</field>
        <field name="model">inventory.store</field>
        <field name="arch" type="xml">

            <form string="Store Management">

                <sheet>

                    <group>

                        <group>

                            <field name="name"/>

                            <field name="store_code" readonly="1"/>

                            <field name="store_manager_id"/>

                        </group>

                        <group>

                            <field name="stock_location_id"/>

                            <field name="active"/>

                        </group>

                    </group>

                    <group>

                        <field name="remarks"/>

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Store Search View -->
    <!-- ========================================================= -->

    <record id="view_inventory_store_search" model="ir.ui.view">
        <field name="name">inventory.store.search</field>
        <field name="model">inventory.store</field>
        <field name="arch" type="xml">

            <search>

                <field name="name"/>

                <field name="store_code"/>

                <field name="store_manager_id"/>

                <filter
                    name="active"
                    string="Active"
                    domain="[('active','=',True)]"/>

                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active','=',False)]"/>

            </search>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Store Action -->
    <!-- ========================================================= -->

    <record id="action_inventory_store" model="ir.actions.act_window">

        <field name="name">Stores</field>

        <field name="res_model">inventory.store</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id" ref="view_inventory_store_search"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first store.
            </p>

            <p>
                Stores represent physical locations that receive inventory from the warehouse.
            </p>

        </field>

    </record>

</odoo>
