<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Low Stock Alert List View (read-only — system generated) -->
    <!-- ========================================================= -->

    <record id="view_inventory_low_stock_alert_tree" model="ir.ui.view">
        <field name="name">inventory.low.stock.alert.tree</field>
        <field name="model">inventory.low.stock.alert</field>
        <field name="arch" type="xml">

            <!-- Column-width standard (module-wide, native Odoo `width`
                 attribute): Medium=140px, Small=90px. Columns grouped
                 Inventory -> Financial -> Stock Health. The identity
                 column (Product) deliberately has NO fixed width so it
                 absorbs leftover space (native Odoo pattern) — fixing
                 every column leaves nothing to absorb it, which stretches
                 all columns uniformly and breaks badge/header alignment. -->
            <list string="Low Stock Alerts" create="false" edit="false" delete="false">

                <field name="product_id"/>

                <field name="location_id" string="Location / Store" width="140px"/>

                <field name="current_qty" width="90px" sum="Total On Hand"/>

                <field name="avg_daily_consumption" width="90px" optional="hide"/>

                <field name="currency_id" column_invisible="1"/>

                <field name="unit_cost" widget="monetary" width="140px" optional="hide"/>

                <field name="value_at_risk" widget="monetary" width="140px" sum="Total Value at Risk"/>

                <field name="days_of_cover" width="90px" invisible="status == 'not_enough_data'"/>

                <field
                    name="status"
                    widget="badge"
                    width="140px"
                    decoration-danger="status == 'active'"
                    decoration-success="status == 'resolved'"
                    decoration-muted="status == 'not_enough_data'"/>

            </list>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Low Stock Alert Search View -->
    <!-- ========================================================= -->

    <record id="view_inventory_low_stock_alert_search" model="ir.ui.view">
        <field name="name">inventory.low.stock.alert.search</field>
        <field name="model">inventory.low.stock.alert</field>
        <field name="arch" type="xml">

            <search>

                <field name="product_id"/>

                <field name="location_id"/>

                <filter name="active" string="Active" domain="[('status','=','active')]"/>

                <filter name="not_enough_data" string="Not Enough Data" domain="[('status','=','not_enough_data')]"/>

                <group>

                    <filter
                        name="group_by_location"
                        string="Location"
                        context="{'group_by':'location_id'}"/>

                    <filter
                        name="group_by_status"
                        string="Status"
                        context="{'group_by':'status'}"/>

                </group>

            </search>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Low Stock Alert Actions — Warehouse Alerts / Store Alerts  -->
    <!-- tabs (FDD §5.13), same pattern as the Requests tabs.       -->
    <!-- ========================================================= -->

    <record id="action_inventory_low_stock_alert_warehouse" model="ir.actions.act_window">

        <field name="name">Low Stock Alerts / Warehouse Alerts</field>

        <field name="res_model">inventory.low.stock.alert</field>

        <field name="view_mode">list</field>

        <field name="domain">[('scope', '=', 'warehouse')]</field>

        <field name="context">{'inventory_tab_group': 'alerts', 'inventory_tab_key': 'warehouse_alerts', 'inventory_info_banner': 'Alerts auto-resolve above 10 days cover; “Not Enough Data” when there is no history. Window = 7 days, threshold = 10 days (fixed).'}</field>

        <field name="search_view_id" ref="view_inventory_low_stock_alert_search"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                No warehouse alerts right now — every product has at least 10 days of cover, or not
                enough history yet to project.
            </p>

        </field>

    </record>

    <record id="action_inventory_low_stock_alert_store" model="ir.actions.act_window">

        <field name="name">Low Stock Alerts / Store Alerts</field>

        <field name="res_model">inventory.low.stock.alert</field>

        <field name="view_mode">list</field>

        <field name="domain">[('scope', '=', 'store')]</field>

        <field name="context">{'inventory_tab_group': 'alerts', 'inventory_tab_key': 'store_alerts', 'inventory_info_banner': 'Alerts auto-resolve above 10 days cover; “Not Enough Data” when there is no history. Window = 7 days, threshold = 10 days (fixed).'}</field>

        <field name="search_view_id" ref="view_inventory_low_stock_alert_search"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                No store alerts right now — every product has at least 10 days of cover, or not enough
                history yet to project.
            </p>

        </field>

    </record>

</odoo>
