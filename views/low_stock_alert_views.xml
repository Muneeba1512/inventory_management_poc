<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Low Stock Alert List View (read-only — system generated) -->
    <!-- ========================================================= -->

    <record id="view_inventory_low_stock_alert_tree" model="ir.ui.view">
        <field name="name">inventory.low.stock.alert.tree</field>
        <field name="model">inventory.low.stock.alert</field>
        <field name="arch" type="xml">

            <!-- Product deliberately has NO width — same pattern as Stock
                 by Location's own Product column: it's the one column
                 that absorbs/shrinks with the viewport, which is what
                 lets the table fit without horizontal scrolling at
                 normal desktop widths.

                 The other five columns' `width` attributes below are the
                 ACTUAL enforced widths, not just a fallback: Odoo's own
                 column-width algorithm (getWidthSpecs() in
                 column_width_hook.js) sets a column's minWidth AND
                 maxWidth to exactly its arch `width=` value, then uses
                 that to compute how much of the remaining viewport space
                 Product (the only shrinkable/expandable column here) gets.
                 An earlier version of this fix set these five widths via
                 `!important` CSS instead of the arch, while the arch still
                 said 150px — Odoo's algorithm reserved space for Product
                 assuming 150px columns, then the CSS silently rendered
                 them wider than that afterward, so the table overflowed
                 the viewport even though Odoo's own math said it fit.

                 The values below are NOT the literal target render widths
                 (Location=260px, On Hand=175px, Value at Risk/Days of
                 Cover/Status=200px) — they're each 32px less. Reason,
                 confirmed via live measurement: column_width_hook.js sets
                 `th.style.width = <arch width> + <cell's own left+right
                 padding>` (see forceColumnWidths() in that file), and this
                 list's cells have `padding: 12px 16px !important` (32px
                 horizontal total) from list_views.scss, so the arch value
                 must be the target minus that 32px for the final rendered
                 width to land on target (e.g. 260px target - 32px padding
                 = 228px arch value for Location). Verified live via CDP
                 that this produces the intended 260/175/200/200/200px
                 render with zero horizontal overflow at a 1366px window.
                 If the padding rule in list_views.scss ever changes, these
                 five values need to change by the same amount to compensate.
                 On Hand, Value at Risk and Days of Cover are
                 right-aligned (Odoo's own numeric default) via a separate
                 alignment-only stylesheet rule; Status stays centered via
                 the module-wide badge rule. This same list also backs the
                 Store Alerts action via a different domain, so every CSS
                 override in list_views.scss applies to Store Alerts too
                 — a known, accepted tradeoff, not a gap. -->
            <list string="Low Stock Alerts" create="false" edit="false" delete="false">

                <field name="product_id"/>

                <field name="location_id" string="Location / Store" width="228px"/>

                <field name="current_qty" width="143px" sum="Total On Hand"/>

                <field name="avg_daily_consumption" width="90px" optional="hide"/>

                <field name="currency_id" column_invisible="1"/>

                <field name="unit_cost" widget="monetary" width="140px" optional="hide"/>

                <field name="value_at_risk" widget="monetary" width="168px" sum="Total Value at Risk"/>

                <field name="days_of_cover" width="168px" invisible="status == 'not_enough_data'"/>

                <field
                    name="status"
                    widget="badge"
                    width="168px"
                    decoration-danger="status == 'active'"
                    decoration-success="status == 'resolved'"
                    decoration-muted="status == 'not_enough_data'"/>

            </list>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Low Stock Alert Search View -->
    <!-- ========================================================= -->

    <record id="view_inventory_low_stock_alert_search" model="ir.ui.view">
        <field name="name">inventory.low.stock.alert.search</field>
        <field name="model">inventory.low.stock.alert</field>
        <field name="arch" type="xml">

            <search>

                <field name="product_id"/>

                <field name="location_id"/>

                <filter name="active" string="Active" domain="[('status','=','active')]"/>

                <filter name="not_enough_data" string="Not Enough Data" domain="[('status','=','not_enough_data')]"/>

                <group>

                    <filter
                        name="group_by_location"
                        string="Location"
                        context="{'group_by':'location_id'}"/>

                    <filter
                        name="group_by_status"
                        string="Status"
                        context="{'group_by':'status'}"/>

                </group>

            </search>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Low Stock Alert Actions — Warehouse Alerts / Store Alerts  -->
    <!-- tabs (FDD §5.13), same pattern as the Requests tabs.       -->
    <!-- ========================================================= -->

    <record id="action_inventory_low_stock_alert_warehouse" model="ir.actions.act_window">

        <field name="name">Low Stock Alerts / Warehouse Alerts</field>

        <field name="res_model">inventory.low.stock.alert</field>

        <field name="view_mode">list</field>

        <field name="domain">[('scope', '=', 'warehouse')]</field>

        <field name="context">{'inventory_tab_group': 'alerts', 'inventory_tab_key': 'warehouse_alerts', 'inventory_info_banner': 'Alerts auto-resolve above 10 days cover; “Not Enough Data” when there is no history. Window = 7 days, threshold = 10 days (fixed).'}</field>

        <field name="search_view_id" ref="view_inventory_low_stock_alert_search"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                No warehouse alerts right now — every product has at least 10 days of cover, or not
                enough history yet to project.
            </p>

        </field>

    </record>

    <record id="action_inventory_low_stock_alert_store" model="ir.actions.act_window">

        <field name="name">Low Stock Alerts / Store Alerts</field>

        <field name="res_model">inventory.low.stock.alert</field>

        <field name="view_mode">list</field>

        <field name="domain">[('scope', '=', 'store')]</field>

        <field name="context">{'inventory_tab_group': 'alerts', 'inventory_tab_key': 'store_alerts', 'inventory_info_banner': 'Alerts auto-resolve above 10 days cover; “Not Enough Data” when there is no history. Window = 7 days, threshold = 10 days (fixed).'}</field>

        <field name="search_view_id" ref="view_inventory_low_stock_alert_search"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                No store alerts right now — every product has at least 10 days of cover, or not enough
                history yet to project.
            </p>

        </field>

    </record>

</odoo>
