<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Stock by Location List View -->
    <!-- ========================================================= -->

    <record id="view_inventory_stock_by_location_list" model="ir.ui.view">
        <field name="name">inventory.stock.by.location.list</field>
        <field name="model">inventory.stock.by.location</field>
        <field name="arch" type="xml">

            <list string="Stock by Location" create="false" edit="false" delete="false">

                <field name="product_id"/>

                <field name="location_id"/>

                <field name="warehouse_id"/>

                <field name="store_id"/>

                <field name="quantity"/>

                <field name="uom_id"/>

                <field name="reserved_quantity"/>

            </list>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Stock by Location Pivot View -->
    <!-- ========================================================= -->

    <record id="view_inventory_stock_by_location_pivot" model="ir.ui.view">
        <field name="name">inventory.stock.by.location.pivot</field>
        <field name="model">inventory.stock.by.location</field>
        <field name="arch" type="xml">

            <pivot string="Stock by Location">

                <field name="location_id" type="row"/>

                <field name="product_id" type="row"/>

                <field name="quantity" type="measure"/>

            </pivot>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Stock by Location Search View -->
    <!-- ========================================================= -->

    <record id="view_inventory_stock_by_location_search" model="ir.ui.view">
        <field name="name">inventory.stock.by.location.search</field>
        <field name="model">inventory.stock.by.location</field>
        <field name="arch" type="xml">

            <search>

                <field name="product_id"/>

                <field name="location_id"/>

                <field name="warehouse_id"/>

                <field name="store_id"/>

                <group>

                    <filter
                        name="group_by_location"
                        string="Location"
                        context="{'group_by':'location_id'}"/>

                    <filter
                        name="group_by_store"
                        string="Store"
                        context="{'group_by':'store_id'}"/>

                    <filter
                        name="group_by_product"
                        string="Product"
                        context="{'group_by':'product_id'}"/>

                </group>

            </search>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Stock by Location Actions — one per tab context. Both      -->
    <!-- reuse the same model/views; record rules already scope     -->
    <!-- what a Store Manager sees on "My Store Stock" (Sprint 2).  -->
    <!-- ========================================================= -->

    <record id="action_inventory_stock_by_location" model="ir.actions.act_window">

        <field name="name">Warehouse / Stock by Location</field>

        <field name="res_model">inventory.stock.by.location</field>

        <field name="view_mode">list,pivot</field>

        <field name="search_view_id" ref="view_inventory_stock_by_location_search"/>

        <field name="context">{'search_default_group_by_location': 1, 'inventory_tab_group': 'warehouse', 'inventory_tab_key': 'stock_by_location'}</field>

        <field name="help" type="html">

            <p>
                Shows current on-hand quantities per product and location.
            </p>

        </field>

    </record>

    <record id="action_inventory_my_store_stock" model="ir.actions.act_window">

        <field name="name">Stores / My Store Stock</field>

        <field name="res_model">inventory.stock.by.location</field>

        <field name="view_mode">list,pivot</field>

        <field name="search_view_id" ref="view_inventory_stock_by_location_search"/>

        <field name="context">{'search_default_group_by_location': 1, 'inventory_tab_group': 'stores', 'inventory_tab_key': 'my_store_stock'}</field>

        <field name="help" type="html">

            <p>
                Shows current on-hand quantities for your store.
            </p>

        </field>

    </record>

</odoo>
