<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Receipt Tree View -->
    <!-- ========================================================= -->

    <record id="view_inventory_receipt_tree" model="ir.ui.view">
        <field name="name">inventory.receipt.tree</field>
        <field name="model">inventory.receipt</field>
        <field name="arch" type="xml">

            <!-- This list intentionally deviates from the module's usual
                 "one flexible identity column" pattern: Reference is
                 fixed at 200px and the other four at 150px each — an
                 exact 25% / 18.75% / 18.75% / 18.75% / 18.75% split of an
                 800px baseline — to keep column spacing even instead of
                 letting Reference absorb all leftover space. All native
                 Odoo `width` attributes, no CSS. -->
            <list string="Receipts">

                <field name="name" width="200px"/>

                <field
                    name="receipt_type"
                    widget="badge"
                    width="150px"
                    decoration-muted="receipt_type in ('manual', 'barcode')"
                    decoration-warning="receipt_type == 'ai_smart'"/>

                <field name="warehouse_id" width="150px"/>

                <field name="create_date" string="Date" width="150px"/>

                <field
                    name="state"
                    widget="badge"
                    width="150px"
                    decoration-muted="state == 'draft'"
                    decoration-info="state == 'review'"
                    decoration-success="state == 'done'"/>

            </list>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Receipt Form View -->
    <!-- ========================================================= -->

    <record id="view_inventory_receipt_form" model="ir.ui.view">
        <field name="name">inventory.receipt.form</field>
        <field name="model">inventory.receipt</field>
        <field name="arch" type="xml">

            <form string="Receipt">

                <header>

                    <button
                        name="action_extract_ai"
                        string="Extract with AI"
                        type="object"
                        class="oe_highlight"
                        invisible="receipt_type != 'ai_smart' or state != 'draft'"/>

                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="oe_highlight"
                        invisible="(receipt_type == 'ai_smart' and state != 'review') or (receipt_type != 'ai_smart' and state != 'draft')"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,review,done"/>

                </header>

                <sheet>

                    <group>

                        <group>

                            <field name="name" readonly="1"/>

                            <field name="receipt_type"/>

                            <field name="warehouse_id" readonly="state != 'draft'"/>

                        </group>

                        <group>

                            <label for="scan_barcode" string="Add by Barcode"
                                   invisible="receipt_type == 'ai_smart'"/>
                            <div class="o_row" invisible="state != 'draft' or receipt_type == 'ai_smart'">

                                <field name="scan_barcode"
                                       placeholder="Scan or type a barcode..."/>

                                <button
                                    name="action_scan_barcode"
                                    string="Add"
                                    type="object"
                                    class="btn-secondary"/>

                            </div>

                        </group>

                    </group>

                    <!-- AI Smart Receiving only — upload + extracted header
                         fields. The user can still correct these before
                         confirming (FDD §5.6: review, not blind trust). -->
                    <group string="Invoice" invisible="receipt_type != 'ai_smart'">

                        <group>

                            <field name="source_file" filename="source_filename" readonly="state == 'done'"/>
                            <field name="source_filename" invisible="1"/>

                        </group>

                        <group>

                            <field name="supplier" readonly="state == 'done'"/>

                            <field name="invoice_number" readonly="state == 'done'"/>

                            <field name="invoice_date" readonly="state == 'done'"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Lines">

                            <!-- Manual / Barcode — unchanged from before this
                                 feature, only hidden for AI Smart receipts. -->
                            <field name="line_ids" invisible="receipt_type == 'ai_smart'" readonly="state != 'draft'">

                                <!-- Column-width standard: Medium=140px,
                                     Small=90px. Product deliberately has
                                     NO fixed width so it absorbs leftover
                                     space (native Odoo pattern). -->
                                <list editable="bottom">

                                    <field name="product_id" required="1"/>

                                    <field name="quantity" width="90px" sum="Total Quantity"/>

                                    <field name="uom_id" width="140px"/>

                                    <field name="currency_id" column_invisible="1"/>

                                    <field name="unit_cost" widget="monetary" width="140px" readonly="1"/>

                                    <field name="line_total" widget="monetary" width="140px" sum="Total" readonly="1"/>

                                </list>

                            </field>

                            <!-- AI Smart Receiving review lines — separate
                                 sub-view so the manual/barcode list above
                                 needs no changes to its own behavior. -->
                            <field name="line_ids" invisible="receipt_type != 'ai_smart'" readonly="state != 'review'">

                                <list editable="bottom">

                                    <field
                                        name="match_status"
                                        widget="badge"
                                        width="160px"
                                        decoration-success="match_status == 'upc'"
                                        decoration-info="match_status == 'name'"
                                        decoration-warning="match_status == 'new'"
                                        decoration-danger="match_status == 'uncertain'"/>

                                    <field name="raw_product_name" string="Extracted Name" readonly="1" width="180px"/>

                                    <field name="upc" string="Extracted UPC" readonly="1" width="120px"/>

                                    <field name="candidate_product_ids" column_invisible="1"/>

                                    <field
                                        name="product_id"
                                        domain="[('id', 'in', candidate_product_ids)]"
                                        readonly="match_status != 'uncertain'"/>

                                    <field name="quantity" width="90px" sum="Total Quantity"/>

                                    <field name="uom_id" width="90px"/>

                                    <field name="currency_id" column_invisible="1"/>

                                    <field name="unit_price" widget="monetary" width="110px"/>

                                    <field name="unit_cost" widget="monetary" width="120px" readonly="1"/>

                                    <button
                                        name="action_open_create_product_wizard"
                                        string="Create Product"
                                        type="object"
                                        invisible="match_status != 'new'"
                                        class="btn-secondary"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Receipt Search View -->
    <!-- ========================================================= -->

    <record id="view_inventory_receipt_search" model="ir.ui.view">
        <field name="name">inventory.receipt.search</field>
        <field name="model">inventory.receipt</field>
        <field name="arch" type="xml">

            <search>

                <field name="name"/>

                <field name="warehouse_id"/>

                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>

                <filter name="done" string="Done" domain="[('state','=','done')]"/>

                <group>

                    <filter
                        name="group_by_type"
                        string="Receiving Method"
                        context="{'group_by':'receipt_type'}"/>

                    <filter
                        name="group_by_warehouse"
                        string="Warehouse"
                        context="{'group_by':'warehouse_id'}"/>

                </group>

            </search>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Receipt Action -->
    <!-- ========================================================= -->

    <record id="action_inventory_receipt" model="ir.actions.act_window">

        <field name="name">Warehouse / Receipts</field>

        <field name="res_model">inventory.receipt</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id" ref="view_inventory_receipt_search"/>

        <field name="context">{'inventory_tab_group': 'warehouse', 'inventory_tab_key': 'receipts'}</field>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first receipt.
            </p>

            <p>
                Receive stock manually or by scanning product barcodes.
            </p>

        </field>

    </record>

</odoo>
