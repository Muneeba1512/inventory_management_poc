<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Store Request Tree View -->
    <!-- ========================================================= -->

    <record id="view_inventory_store_request_tree" model="ir.ui.view">
        <field name="name">inventory.store.request.tree</field>
        <field name="model">inventory.store.request</field>
        <field name="arch" type="xml">

            <!-- Same fixed-width pattern as the Warehouse -> Receipts list
                 (see views/receipt_views.xml): Reference is fixed at
                 200px and the other four at 150px each, instead of
                 letting Reference absorb all leftover space. This one
                 view backs all three Requests tabs (To Approve, To
                 Fulfill, My Requests — see the three actions below, none
                 of which override view_id), so the widths apply
                 identically across all three automatically. All native
                 Odoo `width` attributes, no CSS. -->
            <list string="Store Requests">

                <field name="name" width="200px"/>

                <field name="store_id" width="150px"/>

                <field name="line_count" string="Items" width="150px" class="text-start"/>

                <field name="requested_by" width="150px"/>

                <field
                    name="state"
                    widget="badge"
                    width="150px"
                    decoration-muted="state == 'draft'"
                    decoration-info="state == 'submitted'"
                    decoration-primary="state == 'approved'"
                    decoration-danger="state == 'rejected'"
                    decoration-success="state == 'fulfilled'"/>

            </list>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Store Request Form View -->
    <!-- ========================================================= -->

    <record id="view_inventory_store_request_form" model="ir.ui.view">
        <field name="name">inventory.store.request.form</field>
        <field name="model">inventory.store.request</field>
        <field name="arch" type="xml">

            <form string="Store Request">

                <header>

                    <button
                        name="action_submit"
                        string="Submit"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'draft'"/>

                    <button
                        name="action_approve"
                        string="Approve"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'submitted'"/>

                    <button
                        name="action_open_reject_wizard"
                        string="Reject"
                        type="object"
                        invisible="state not in ('submitted', 'approved')"/>

                    <button
                        name="action_fulfill"
                        string="Fulfill"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'approved'"/>

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,submitted,approved,fulfilled"/>

                </header>

                <sheet>

                    <div class="alert alert-warning" role="alert" invisible="not has_short_lines or state not in ('draft', 'submitted', 'approved')">
                        Warehouse stock cannot fully cover this request. It must be
                        <strong>rejected</strong> — partial fulfillment is not supported.
                    </div>

                    <group>

                        <group>

                            <field name="name" readonly="1"/>

                            <field name="store_id" readonly="state != 'draft'"/>

                            <field name="requested_by" readonly="1"/>

                        </group>

                        <group>

                            <field name="approver_id" readonly="1" invisible="not approver_id"/>

                            <field name="reject_reason" readonly="1" invisible="state != 'rejected'"/>

                            <field name="picking_id" readonly="1" invisible="not picking_id"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Lines">

                            <field name="line_ids" readonly="state != 'draft'">

                                <!-- Column-width standard: Medium=140px,
                                     Small=90px. Product deliberately has
                                     NO fixed width so it absorbs leftover
                                     space (native Odoo pattern). -->
                                <list editable="bottom" decoration-danger="qty_requested &gt; qty_available" decoration-success="qty_requested &lt;= qty_available">

                                    <field name="product_id"/>

                                    <field name="qty_requested" width="90px"/>

                                    <field name="uom_id" width="140px"/>

                                    <field name="qty_available" width="90px"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Store Request Search View -->
    <!-- ========================================================= -->

    <record id="view_inventory_store_request_search" model="ir.ui.view">
        <field name="name">inventory.store.request.search</field>
        <field name="model">inventory.store.request</field>
        <field name="arch" type="xml">

            <search>

                <field name="name"/>

                <field name="store_id"/>

                <field name="requested_by"/>

                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>

                <filter name="fulfilled" string="Fulfilled" domain="[('state','=','fulfilled')]"/>

                <filter name="rejected" string="Rejected" domain="[('state','=','rejected')]"/>

                <group>

                    <filter
                        name="group_by_store"
                        string="Store"
                        context="{'group_by':'store_id'}"/>

                    <filter
                        name="group_by_state"
                        string="Status"
                        context="{'group_by':'state'}"/>

                </group>

            </search>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- Store Request Actions — one per tab (FDD §5.8: "tabs are   -->
    <!-- saved filters/actions on the same list, not separate       -->
    <!-- models"). Each carries the tab-group context read by the   -->
    <!-- custom InventoryTabStrip widget. -->
    <!-- ========================================================= -->

    <record id="action_inventory_store_request_to_approve" model="ir.actions.act_window">

        <field name="name">Requests / To Approve</field>

        <field name="res_model">inventory.store.request</field>

        <field name="view_mode">list,form</field>

        <field name="domain">[('state', '=', 'submitted')]</field>

        <field name="context">{'inventory_tab_group': 'requests', 'inventory_tab_key': 'to_approve'}</field>

        <field name="search_view_id" ref="view_inventory_store_request_search"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                No requests waiting for approval.
            </p>

            <p>
                Store Managers request stock from the warehouse here.
            </p>

        </field>

    </record>

    <record id="action_inventory_store_request_to_fulfill" model="ir.actions.act_window">

        <field name="name">Requests / To Fulfill</field>

        <field name="res_model">inventory.store.request</field>

        <field name="view_mode">list,form</field>

        <field name="domain">[('state', '=', 'approved')]</field>

        <field name="context">{'inventory_tab_group': 'requests', 'inventory_tab_key': 'to_fulfill'}</field>

        <field name="search_view_id" ref="view_inventory_store_request_search"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                No approved requests waiting to be fulfilled.
            </p>

        </field>

    </record>

    <record id="action_inventory_store_request_my_requests" model="ir.actions.act_window">

        <field name="name">Requests / My Requests</field>

        <field name="res_model">inventory.store.request</field>

        <field name="view_mode">list,form</field>

        <field name="domain">[('requested_by', '=', uid)]</field>

        <field name="context">{'inventory_tab_group': 'requests', 'inventory_tab_key': 'my_requests', 'default_requested_by': uid}</field>

        <field name="search_view_id" ref="view_inventory_store_request_search"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first store request.
            </p>

            <p>
                Store Managers request stock from the warehouse here.
            </p>

        </field>

    </record>

</odoo>
