<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//t[@t-component='props.Renderer']" position="before">
            <InventoryTabStrip
                t-if="inventoryTabGroup"
                group="inventoryTabGroup"
                activeKey="inventoryTabKey"/>
            <div t-if="inventoryInfoBanner" class="alert alert-info m-2 mb-0" role="alert" t-esc="inventoryInfoBanner"/>
        </xpath>
    </t>

</templates>
