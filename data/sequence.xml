<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="seq_inventory_store" model="ir.sequence">
        <field name="name">Inventory Store Sequence</field>
        <field name="code">inventory.store</field>
        <field name="prefix">STR</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="number_next">1</field>
    </record>

    <record id="seq_inventory_receipt" model="ir.sequence">
        <field name="name">Inventory Receipt Sequence</field>
        <field name="code">inventory.receipt</field>
        <field name="prefix">RCT</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="number_next">1</field>
    </record>

    <record id="seq_inventory_store_request" model="ir.sequence">
        <field name="name">Store Request Sequence</field>
        <field name="code">inventory.store.request</field>
        <field name="prefix">REQ</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="number_next">1</field>
    </record>

    <record id="seq_inventory_store_consumption" model="ir.sequence">
        <field name="name">Store Consumption Sequence</field>
        <field name="code">inventory.store.consumption</field>
        <field name="prefix">CON</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="number_next">1</field>
    </record>

</odoo>
